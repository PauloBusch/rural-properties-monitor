    {
      "title": "Tabela: Leituras Recentes dos Sensores",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "_time" }, "properties": [{ "id": "displayName", "value": "Dia e hora" }, { "id": "unit", "value": "time:DD/MM/YYYY - HH:mm:ss" }] },
