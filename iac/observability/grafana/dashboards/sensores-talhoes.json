          "datasource": { "type": "influxdb", "uid": "influxdb" },
          "query": "from(bucket: \"ingress\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\")\n  |> pivot(rowKey: [\"_time\", \"plotId\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)",
          "refId": "A"
