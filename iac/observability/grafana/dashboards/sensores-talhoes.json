          { "matcher": { "id": "byName", "options": "precipitation" }, "properties": [{ "id": "unit", "value": "mm" }, { "id": "displayName", "value": "Precipitação (mm)" }] },
          { "matcher": { "id": "byName", "options": "plotId" }, "properties": [{ "id": "displayName", "value": "Talhao" }] }
        ]
      },
      "targets": [
