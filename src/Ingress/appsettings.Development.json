{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "Broker": "localhost:9092",
    "Topic": "sensor-data",
    "GroupId": "ingress-api-group"
  },
  "InfluxDbConfig": {
    "Url": "http://localhost:8086",
    "Token": "influxdb-token",
    "Org": "myorg",
    "Bucket": "ingress"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/RuralTech",
    "Audience": "ruraltech-services",
    "ValidIssuers": [
      "http://localhost:8080/realms/RuralTech"
    ],
    "RequireHttpsMetadata": false
  }
}
