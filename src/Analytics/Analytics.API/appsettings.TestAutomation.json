{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithEnvironmentName", "WithThreadId" ]
  },
  "Services": {
    "IngressApi": "http://localhost:5001/api/"
  },
  "Keycloak": {
    "TokenUrl": "http://localhost:8080/realms/RuralTech/protocol/openid-connect/token",
    "ClientId": "ruraltech-services",
    "GrantType": "client_credentials"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
